{
  "name": "auditpilot",
  "version": "1.0.0",
  "description": "Automated QA audit tool for multilingual content",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first -p \"[{name}]\" -n \"Vite,Electron\" -c \"cyan,green\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --port 5173 --strictPort",
    "dev:electron": "electron .",
    "build": "vite build",
    "package": "npm run build && electron-builder --config electron-builder.config.js",
    "test-server": "node test-site/server.js",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.4",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.1/xlsx-0.20.1.tgz",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.42.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
